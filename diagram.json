{
  "version": 1,
  "author": "Detector de Barulho",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -120, "left": -20, "attrs": {} },

    { "type": "wokwi-resistor", "id": "r1", "top": 120, "left": -120, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 140, "left": -120, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 160, "left": -120, "attrs": { "value": "220" } },

    { "type": "wokwi-led", "id": "led_verde",    "top": 40, "left": -220, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "led_amarelo",  "top": 40, "left": -180, "attrs": { "color": "yellow" } },
    { "type": "wokwi-led", "id": "led_vermelho", "top": 40, "left": -140, "attrs": { "color": "red" } },

    { "type": "wokwi-buzzer", "id": "bz1", "top": 200, "left": -200, "attrs": { "volume": "0.3" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.2", "black", [] ],
    [ "pot1:SIG", "esp:34", "orange", [] ],

    [ "esp:25", "r1:2", "green", [] ],
    [ "r1:1", "led_verde:A", "green", [] ],
    [ "led_verde:C", "esp:GND.1", "black", [] ],

    [ "esp:26", "r2:2", "gold", [] ],
    [ "r2:1", "led_amarelo:A", "gold", [] ],
    [ "led_amarelo:C", "esp:GND.1", "black", [] ],

    [ "esp:27", "r3:2", "red", [] ],
    [ "r3:1", "led_vermelho:A", "red", [] ],
    [ "led_vermelho:C", "esp:GND.1", "black", [] ],

    [ "esp:14", "bz1:2", "purple", [] ],
    [ "bz1:1", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
